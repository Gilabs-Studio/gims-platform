# ==============================================================================
# GIMS API - Production Environment Variables Example
# Salin file ini ke: apps/api/.env.production (di lokal)
# JANGAN COMMIT FILE apps/api/.env.production (sudah di-.gitignore)
# ==============================================================================

# Server
PORT=8080
ENV=production
APP_ENV=production
GIN_MODE=release
APP_TIMEZONE=Asia/Jakarta
FRONTEND_BASE_URL=https://gims.gilabs.id
ROOT_DOMAIN=.gilabs.id

# Database PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_db_yang_kuat
DB_NAME=gims_erp
DB_SSLMODE=disable

# Redis Cache & PubSub
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & JWT
# Buat string acak panjang: openssl rand -hex 32
JWT_SECRET=ganti_dengan_jwt_secret_acak_minimal_32_karakter
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=gims-platform
JWT_ACCESS_TTL=24
JWT_REFRESH_TTL=7
CSRF_ENABLED=true

# Database Migration & Seeders
# Untuk deploy perdana ke DB baru, set true.
RUN_MIGRATIONS=true
RUN_SEEDERS=true
MIGRATE_ONCE=true
SEED_ONCE=true
SEED_DEFAULT_PASSWORD=admin123
SEED_MINIMAL_DATA=true

# Local / Cloud Storage
STORAGE_UPLOAD_DIR=/app/uploads
STORAGE_MAX_UPLOAD_SIZE=10485760

# Cloudflare R2 (Opsional jika pakai R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# AI & External Integrations (Opsional)
CEREBRAS_API_KEY=
XENDIT_CREDENTIAL_ENCRYPTION_KEY=
XENDIT_BILLING_RECURRING_SECRET_KEY=
XENDIT_BILLING_WEBHOOK_TOKEN=
RESEND_API_KEY=
