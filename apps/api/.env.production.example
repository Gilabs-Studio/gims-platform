
# =========================================================
# SERVER CONFIGURATION
# =========================================================
PORT=8080
APP_ENV=production
ENV=production
APP_TIMEZONE=Asia/Jakarta
GIN_MODE=release
SERVER_SHUTDOWN_TIMEOUT_SEC=30

# =========================================================
# STARTUP BEHAVIOR
# =========================================================
# Run production migrations manually before restarting the API.
RUN_MIGRATIONS=false

# Never run seeders automatically in production.
RUN_SEEDERS=false

# =========================================================
# DESTRUCTIVE OPERATION GUARDS
# =========================================================
# These values must always remain false in production.
DROP_ALL_TABLES=false
SEED_CLEANUP_DATABASE=false

# =========================================================
# DATABASE CONFIGURATION
# =========================================================
# Use the Docker Compose service name.
# Do not use localhost inside the API container.
DB_HOST=postgres
DB_PORT=5432

DB_USER=gims_prod_user
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_NAME=gims_erp_production

# Use disable for PostgreSQL inside the same private Docker network.
# Change this when using an external managed PostgreSQL server with SSL.
DB_SSLMODE=disable

DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_TIME_MINUTES=10

# =========================================================
# REDIS CONFIGURATION
# =========================================================
# Use the Docker Compose service name.
# Do not use localhost inside the API container.
REDIS_HOST=redis
REDIS_PORT=6379

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

REDIS_DIAL_TIMEOUT_SEC=10
REDIS_READ_TIMEOUT_SEC=30
REDIS_WRITE_TIMEOUT_SEC=30
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# =========================================================
# JWT AUTHENTICATION
# =========================================================
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARACTER_RANDOM_SECRET
JWT_ACCESS_TTL=24
JWT_REFRESH_TTL=7

# =========================================================
# FRONTEND AND DOMAIN
# =========================================================
FRONTEND_BASE_URL=https://salesview.id
ROOT_DOMAIN=.salesview.id

# Add all allowed frontend origins separated by commas.
CORS_ALLOWED_ORIGINS=https://salesview.id,https://www.salesview.id

# =========================================================
# SECURITY CONFIGURATION
# =========================================================
# Enable because the API runs behind your trusted Nginx reverse proxy.
PROXY_HEADERS_ENABLED=true

# Keep enabled when authentication uses cookies.
CSRF_ENABLED=true

HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Enable only after all required subdomains permanently support HTTPS.
HSTS_PRELOAD=false

# =========================================================
# RATE LIMITING CONFIGURATION
# =========================================================
RATE_LIMIT_LOGIN_REQUESTS=3
RATE_LIMIT_LOGIN_WINDOW=900

RATE_LIMIT_REFRESH_REQUESTS=10
RATE_LIMIT_REFRESH_WINDOW=3600

RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW=3600

RATE_LIMIT_GENERAL_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW=60

RATE_LIMIT_PUBLIC_REQUESTS=200
RATE_LIMIT_PUBLIC_WINDOW=60

RATE_LIMIT_LOGIN_BY_EMAIL_REQUESTS=5
RATE_LIMIT_LOGIN_BY_EMAIL_WINDOW=900

RATE_LIMIT_LOGIN_GLOBAL_REQUESTS=50
RATE_LIMIT_LOGIN_GLOBAL_WINDOW=60

# Reject rate-limited requests when Redis is unavailable.
RATE_LIMIT_FAIL_CLOSED_ON_REDIS_ERROR=true

# =========================================================
# LOCAL UPLOAD STORAGE
# =========================================================
# Must match the Docker volume mount:
#
#   uploads_data:/app/uploads
#
STORAGE_UPLOAD_DIR=/app/uploads
STORAGE_BASE_URL=/uploads
STORAGE_MAX_UPLOAD_SIZE=10485760

# =========================================================
# CLOUDFLARE R2 OBJECT STORAGE
# =========================================================
R2_ACCOUNT_ID=CHANGE_ME_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=CHANGE_ME_R2_BUCKET_NAME
R2_PUBLIC_URL=CHANGE_ME_R2_PUBLIC_URL

# =========================================================
# CEREBRAS AI CONFIGURATION
# =========================================================
CEREBRAS_BASE_URL=https://api.cerebras.ai
CEREBRAS_API_KEY=CHANGE_ME_CEREBRAS_API_KEY

# =========================================================
# XENDIT PAYMENT GATEWAY
# =========================================================
XENDIT_SECRET_KEY=CHANGE_ME_XENDIT_SECRET_KEY
XENDIT_WEBHOOK_TOKEN=CHANGE_ME_XENDIT_WEBHOOK_TOKEN

# Confirm the required format in your Golang encryption implementation.
XENDIT_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_ENCRYPTION_KEY

# Safety guard: never simulate paid registration in production.
DEV_SIMULATE_PAID_REGISTRATION=false

# =========================================================
# RESEND EMAIL CONFIGURATION
# =========================================================
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
RESEND_FROM_EMAIL=SalesView <noreply@salesview.id>

# =========================================================
# N8N AUTOMATION CONFIGURATION
# =========================================================
N8N_LEADS_WEBHOOK_URL=

# =========================================================
# SEEDER CONFIGURATION
# =========================================================
# Seeder must only be executed manually when required.
SEED_ONLY_MASTER_DATA=true
SEED_MINIMAL_DATA=false

SEED_DEFAULT_EMAIL=admin@salesview.id
SEED_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# =========================================================
# FINANCE VALIDATION
# =========================================================
VALIDATE_FINANCE_START=
VALIDATE_FINANCE_END=

# =========================================================
# OPTIONAL SUBSCRIPTION CONFIGURATION
# =========================================================
SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# =========================================================
# OPTIONAL OBSERVABILITY
# =========================================================
METRICS_ENABLED=false
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

PPROF_ENABLED=false
PPROF_TOKEN=CHANGE_ME_PPROF_TOKEN

# Add only after Sentry SDK is implemented in the Golang API.
SENTRY_DSN=
