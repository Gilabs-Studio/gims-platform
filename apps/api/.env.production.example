# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# ⚠️  CRITICAL SECURITY NOTICE:
# - NEVER commit this file to version control
# - Use secrets management (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Rotate all credentials regularly
# - Ensure Redis is accessible from app server (NOT localhost in distributed setup)
# - Enable error tracking with Sentry for production incidents
# ===========================================

# ⚠️ COMMON PRODUCTION ISSUES
# If you get "SERVICE_UNAVAILABLE" + "rate_limiter_backend_unavailable":
# → Redis connection failed. Check REDIS_HOST is accessible from app server.
#   (e.g., if app is on 1.2.3.4 and Redis is on 5.6.7.8, set REDIS_HOST=5.6.7.8, NOT localhost)
# → Verify REDIS_PORT (default 6379, not 6380)
# → Verify REDIS_PASSWORD if required
# → Test with: redis-cli -h REDIS_HOST -p REDIS_PORT ping

# Server Configuration
PORT=8087
APP_ENV=production
APP_TIMEZONE=Asia/Jakarta  # IANA timezone

# Startup Behavior - PRODUCTION SETTINGS
RUN_MIGRATIONS=false  # ⚠️ Run migrations manually in production
RUN_SEEDERS=false     # ⚠️ CRITICAL: NEVER enable seeders in production

# Database Configuration
DB_HOST=prod-db.internal  # NOT localhost in distributed setup
DB_PORT=5432
DB_USER=gims_prod_user
DB_PASSWORD=CHANGE_ME  # Use secrets manager
DB_NAME=gims_erp_production
DB_SSLMODE=require  # Always require SSL in production
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_TIME_MINUTES=10

# ⚠️ CRITICAL: Redis Configuration
# In production, Redis MUST be accessible from app server.
# If app and Redis on different servers: REDIS_HOST must be Redis server IP/hostname
# If app and Redis on same server: REDIS_HOST=localhost is OK, but NOT recommended in cloud
REDIS_HOST=prod-redis.internal  # ⚠️ NOT localhost if Redis is on different server
REDIS_PORT=6379  # Standard Redis port (NOT 6380)
REDIS_PASSWORD=CHANGE_ME  # Use secrets manager if Redis requires password
REDIS_DB=0
REDIS_DIAL_TIMEOUT_SEC=10
REDIS_READ_TIMEOUT_SEC=30
REDIS_WRITE_TIMEOUT_SEC=30
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# JWT Configuration
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING  # Use secrets manager
JWT_ACCESS_TTL=24  # Hours
JWT_REFRESH_TTL=7  # Days

# Cerebras AI Configuration (optional)
CEREBRAS_BASE_URL=https://api.cerebras.ai
CEREBRAS_API_KEY=CHANGE_ME  # Use secrets manager

# Xendit Payment Gateway Configuration
XENDIT_SECRET_KEY=CHANGE_ME  # Use secrets manager
XENDIT_WEBHOOK_TOKEN=CHANGE_ME  # Use secrets manager
XENDIT_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME  # Use secrets manager

# Storage Configuration
STORAGE_UPLOAD_DIR=/var/uploads  # Absolute path for production
STORAGE_BASE_URL=/uploads  # Relative to app domain or CDN URL
STORAGE_MAX_UPLOAD_SIZE=10485760  # 10MB

# Seeder Configuration (optional master data seeding)
SEED_DEFAULT_EMAIL=admin@yourdomain.com
SEED_DEFAULT_PASSWORD=CHANGE_ME  # Use secrets manager

# Rate Limiting Configuration
RATE_LIMIT_LOGIN_REQUESTS=3
RATE_LIMIT_LOGIN_WINDOW=900  # 15 minutes
RATE_LIMIT_REFRESH_REQUESTS=10
RATE_LIMIT_REFRESH_WINDOW=3600  # 1 hour
RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW=3600  # 1 hour
RATE_LIMIT_GENERAL_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW=60  # 1 minute
RATE_LIMIT_PUBLIC_REQUESTS=200
RATE_LIMIT_PUBLIC_WINDOW=60  # 1 minute
RATE_LIMIT_LOGIN_BY_EMAIL_REQUESTS=5
RATE_LIMIT_LOGIN_BY_EMAIL_WINDOW=900  # 15 minutes
RATE_LIMIT_LOGIN_GLOBAL_REQUESTS=50
RATE_LIMIT_LOGIN_GLOBAL_WINDOW=60  # 1 minute
RATE_LIMIT_FAIL_CLOSED_ON_REDIS_ERROR=true  # Reject requests if Redis fails

# Security Configuration
CSRF_ENABLED=true
PROXY_HEADERS_ENABLED=false  # Only set to true if behind trusted reverse proxy
HSTS_MAX_AGE=31536000  # 1 year
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Frontend URL
FRONTEND_BASE_URL=https://app.yourdomain.com
ROOT_DOMAIN=.yourdomain.com  # For cross-subdomain cookies (include leading dot)

# Optional: Performance & Observability
METRICS_ENABLED=false
METRICS_TOKEN=CHANGE_ME
PPROF_ENABLED=false
PPROF_TOKEN=CHANGE_ME

# Optional: Subscription Configuration
SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# ===========================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ===========================================
# [ ] All CHANGE_ME secrets replaced with real values from secrets manager
# [ ] Redis connection tested: redis-cli -h REDIS_HOST -p REDIS_PORT ping
# [ ] Database SSL enabled and certificates verified
# [ ] Database backups configured
# [ ] REDIS_HOST is accessible from app server (NOT localhost unless on same host)
# [ ] Rate limiting properly tuned for your traffic patterns
# [ ] Sentry monitoring setup (implement in code if needed)
# [ ] Monitoring and alerting configured
# [ ] Graceful shutdown configured (SERVER_SHUTDOWN_TIMEOUT_SEC)
# ===========================================
