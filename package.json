{
  "name": "gims",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "cd apps/web && pnpm dev",
    "dev:web:setup": "cd apps/web && pnpm install",
    "dev:web:clean": "cd apps/web && pnpm clean:cache",
    "dev:api": "cd apps/api && docker compose down -v && docker compose up -d --build",
    "dev:db": "cd apps/api && docker compose down -v && docker compose up -d postgres redis",
    "dev:api:local": "cd apps/api && air",
    "dev:local": "pnpm run dev:db & pnpm run dev:api:local",
    "dev:web-api": "pnpm run dev:api & pnpm run dev:web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo run check-types && turbo run lint --filter=@repo/web",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "k6:profiler": "k6 run --out json=k6/reports/profiler.json k6/tests/endpoint-profiler.js",
    "k6:profiler:local": "k6 run -e RELAXED=1 --out json=k6/reports/profiler-local.json k6/tests/endpoint-profiler.js",
    "k6:analyze": "node k6/scripts/analyze-report.js",
    "k6:seed": "node k6/scripts/seed-persist.js",
    "k6:seed:dry": "node k6/scripts/seed-persist.js --dry-run",
    "k6:seed:staging": "node k6/scripts/seed-persist.js --env=staging",
    "k6:smoke": "k6 run k6/tests/smoke.js",
    "k6:smoke:staging": "k6 run -e K6_ENV=staging k6/tests/smoke.js",
    "k6:smoke:prod": "k6 run -e K6_ENV=production k6/tests/smoke.js",
    "k6:load": "k6 run k6/tests/load.js",
    "k6:load:staging": "k6 run -e K6_ENV=staging k6/tests/load.js",
    "k6:stress": "k6 run k6/tests/stress.js",
    "k6:spike": "k6 run k6/tests/spike.js",
    "k6:soak": "k6 run k6/tests/soak.js",
    "k6:breakpoint": "k6 run k6/tests/breakpoint.js",
    "k6:security": "k6 run k6/tests/security-negative.js",
    "k6:concurrency": "k6 run k6/tests/domain-concurrency.js",
    "k6:browser": "cross-env K6_BROWSER_ENABLED=true k6 run k6/tests/browser-dashboard.js",
    "k6:inspect": "k6 inspect k6/tests/smoke.js && k6 inspect k6/tests/load.js && k6 inspect k6/tests/security-negative.js",
    "k6:validate": "k6 inspect k6/tests/smoke.js && k6 inspect k6/tests/load.js && k6 inspect k6/tests/stress.js && k6 inspect k6/tests/spike.js && k6 inspect k6/tests/soak.js && k6 inspect k6/tests/breakpoint.js && k6 inspect k6/tests/security-negative.js && k6 inspect k6/tests/domain-concurrency.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "ajv": "6.14.0",
      "brace-expansion": "^5.0.12",
      "flatted": "3.4.2",
      "minimatch": "9.0.7",
      "picomatch": "4.0.4",
      "js-yaml": "^4.3.2",
      "postcss": "^8.5.23",
      "dompurify": "^3.4.17",
      "nanoid": "^3.3.18",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "ws": "^7.5.11",
      "form-data": "^4.0.6",
      "follow-redirects": "^1.16.1",
      "browserslist": "^4.28.7",
      "fflate": "^0.4.9",
      "@humanfs/node": "^0.16.8",
      "@babel/core": "^7.29.6"
    }
  }
}
