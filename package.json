{
  "name": "gims",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "cd apps/web && pnpm install && pnpm dev",
    "dev:api": "cd apps/api && docker compose down -v && docker compose up -d --build",
    "dev:db": "cd apps/api && docker compose down -v && docker compose up -d postgres redis",
    "dev:api:local": "cd apps/api && air",
    "dev:local": "pnpm run dev:db & pnpm run dev:api:local",
    "dev:web-api": "pnpm run dev:api & pnpm run dev:web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo run check-types && turbo run lint --filter=@repo/web",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "k6:smoke": "k6 run k6/tests/smoke-test.js",
    "k6:smoke:local": "k6 run -e RELAXED=1 k6/tests/smoke-test.js",
    "k6:load:baseline": "k6 run -e VUS=20 -e DURATION=10m k6/tests/load-test.js",
    "k6:load:peak": "k6 run -e VUS=50 -e DURATION=15m k6/tests/load-test.js",
    "k6:soak": "k6 run -e VUS=30 -e DURATION=60m k6/tests/soak-test.js",
    "k6:stress:quick": "k6 run -e QUICK=1 -e MAX_VUS=20 k6/tests/stress-test.js",
    "k6:stress:full": "k6 run -e MAX_VUS=100 k6/tests/stress-test.js",
    "k6:transaction": "k6 run k6/transaction-test.js",
    "k6:transaction:local": "k6 run -e RELAXED=1 k6/transaction-test.js",
    "k6:transaction:extended": "k6 run -e VUS=5 -e DURATION=15m k6/transaction-test.js",
    "k6:spike": "k6 run k6/tests/spike-test.js",
    "k6:soak:test": "k6 run k6/tests/soak-test.js",
    "k6:soak:weekly": "k6 run -e VUS=30 -e DURATION=60m k6/tests/soak-test.js",
    "k6:concurrent": "k6 run -e VUS=5 -e DURATION=3m k6/tests/concurrent-mutation-test.js",
    "k6:rate-limit": "k6 run k6/tests/rate-limit-test.js",
    "k6:transaction:v2": "k6 run k6/tests/transaction-test.js",
    "k6:transaction:v2:local": "k6 run -e RELAXED=1 k6/tests/transaction-test.js",
    "k6:transaction:v2:extended": "k6 run -e VUS=5 -e DURATION=15m k6/tests/transaction-test.js",
    "k6:all": "pnpm run k6:smoke && pnpm run k6:load:baseline && pnpm run k6:stress:quick"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "ajv": "6.14.0",
      "brace-expansion": "5.0.5",
      "flatted": "3.4.2",
      "minimatch": "9.0.7",
      "picomatch": "4.0.4",
      "js-yaml": "4.1.1",
      "postcss": "8.5.10"
    }
  }
}
