meta {
  name: Create Employee
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/master-data/employees
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Budi Santoso",
    "email": "budi.santoso@example.com",
    "phone": "+628123456789",
    "division_id": "division-uuid-here",
    "job_position_id": "job-position-uuid-here"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new employee record.
  Permission required: `employee.create`
}
