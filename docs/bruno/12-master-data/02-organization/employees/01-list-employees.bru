meta {
  name: List Employees
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/organization/employees?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List organization employees.
  Permission required: `employee.read`
}
