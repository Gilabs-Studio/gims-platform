meta {
  name: Create Supplier
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/master-data/suppliers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "PT Supplier Utama",
    "code": "SUP-001",
    "email": "contact@supplierutama.com",
    "phone": "+628111222333",
    "supplier_type_id": "supplier-type-uuid-here"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new supplier master data record.
  Permission required: `supplier.create`
}
