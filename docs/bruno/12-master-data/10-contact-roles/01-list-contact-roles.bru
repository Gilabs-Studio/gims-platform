meta {
  name: List Contact Roles
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/master-data/contact-roles?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List CRM contact roles (e.g. Decision Maker, Purchasing, Technical Lead).
  Permission required: `crm_contact_role.read`
}
