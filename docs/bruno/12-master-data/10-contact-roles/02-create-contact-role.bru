meta {
  name: Create Contact Role
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/master-data/contact-roles
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Decision Maker",
    "code": "DECISION_MAKER"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new CRM contact role option.
  Permission required: `crm_contact_role.create`
}
