meta {
  name: Update Warehouse
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/master-data/warehouses/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Central Warehouse Surabaya",
    "address": "Jl. Industri No. 45-47, Surabaya"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update warehouse details.
  Permission required: `warehouse.update`
}
