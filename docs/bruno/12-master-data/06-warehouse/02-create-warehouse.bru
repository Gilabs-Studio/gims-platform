meta {
  name: Create Warehouse
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/master-data/warehouses
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Main Warehouse Surabaya",
    "code": "WH-SUB-01",
    "address": "Jl. Industri No. 45, Surabaya",
    "is_active": true
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new warehouse record.
  Permission required: `warehouse.create`
}
