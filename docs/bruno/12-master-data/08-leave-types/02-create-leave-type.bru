meta {
  name: Create Leave Type
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/master-data/leave-types
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Annual Leave",
    "code": "ANNUAL",
    "days_allowance": 12,
    "is_paid": true
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new leave type policy.
  Permission required: `leave_type.create`
}
