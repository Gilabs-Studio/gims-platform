meta {
  name: List Leave Types
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/master-data/leave-types?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List leave types (e.g. Annual, Sick, Maternity).
  Permission required: `leave_type.read`
}
