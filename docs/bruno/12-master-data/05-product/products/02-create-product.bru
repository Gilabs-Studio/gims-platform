meta {
  name: Create Product
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/master-data/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Industrial Lubricant 5L",
    "sku": "PROD-LUB-001",
    "product_category_id": "category-uuid-here",
    "uom_id": "uom-uuid-here",
    "sales_price": 125000,
    "cost_price": 85000
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new product record.
  Permission required: `product.create`
}
