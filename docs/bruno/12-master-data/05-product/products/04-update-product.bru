meta {
  name: Update Product
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/master-data/products/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "sales_price": 130000,
    "notes": "Adjusted selling price"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update product details.
  Permission required: `product.update`
}
