meta {
  name: Update Product Recipe BOM
  type: http
  seq: 5
}

put {
  url: {{base_url}}/api/v1/master-data/products/:id/recipe
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "components": [
      {
        "raw_material_id": "raw-material-uuid-here",
        "quantity": 2.5,
        "uom_id": "uom-uuid-here"
      }
    ]
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update Bill of Materials (BOM) recipe components for a product.
  Permission required: `product.recipe.update`
}
