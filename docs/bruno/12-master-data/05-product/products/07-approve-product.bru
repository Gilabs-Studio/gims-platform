meta {
  name: Approve Product
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/master-data/products/:id/approve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "status": "APPROVED",
    "notes": "Product specifications and pricing verified"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Approve new product for active sales/purchasing catalog.
  Permission required: `product.approve`
}
