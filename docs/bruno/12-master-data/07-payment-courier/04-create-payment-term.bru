meta {
  name: Create Payment Term
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/master-data/payment-terms
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Net 30 Days",
    "code": "NET30",
    "days": 30
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new payment term.
  Permission required: `payment_term.create`
}
