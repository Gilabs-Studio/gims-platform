meta {
  name: List Payment Terms
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/master-data/payment-terms?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
