meta {
  name: Create Currency
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/master-data/currencies
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "code": "USD",
    "name": "US Dollar",
    "symbol": "$",
    "exchange_rate": 16200
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new currency.
  Permission required: `currency.create`
}
