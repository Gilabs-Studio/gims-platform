meta {
  name: Create Sales Referral
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/master-data/sales-referrals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "referral_code": "REF-PARTNER-01",
    "partner_name": "PT Partner Affiliate",
    "commission_rate": 5.0
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new sales referral program code.
  Permission required: `sales_referral.create`
}
