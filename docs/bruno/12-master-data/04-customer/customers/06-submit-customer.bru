meta {
  name: Submit Customer for Approval
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/master-data/customers/:id/submit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Submitting new customer onboarding for manager sign-off"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Submit customer record for approval workflow.
  Permission required: `customer.submit`
}
