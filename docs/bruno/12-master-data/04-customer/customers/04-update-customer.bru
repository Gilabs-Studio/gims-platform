meta {
  name: Update Customer
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/master-data/customers/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "credit_limit": 150000000,
    "notes": "Credit limit increased after risk evaluation"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update customer details.
  Permission required: `customer.update`
}
