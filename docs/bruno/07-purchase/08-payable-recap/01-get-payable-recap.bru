meta {
  name: Get Accounts Payable Recap
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/purchase/payable-recap?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get summary recap of outstanding vendor payables.
  Permission required: `payable_recap.read`
}
