meta {
  name: Approve Purchase Requisition
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/purchase/purchase-requisitions/:id/approve
  body: none
  auth: none
}

params:path {
  id: requisition-uuid-here
}

headers {
  X-CSRF-Token: {{csrf_token}}
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Approve a pending purchase requisition.
  Permission required: `purchase_requisition.approve`
}
