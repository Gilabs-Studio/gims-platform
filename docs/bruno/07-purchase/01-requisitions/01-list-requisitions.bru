meta {
  name: List Purchase Requisitions
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/purchase/purchase-requisitions?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List purchase requisitions with pagination and status filters.
  Permission required: `purchase_requisition.read`
}
