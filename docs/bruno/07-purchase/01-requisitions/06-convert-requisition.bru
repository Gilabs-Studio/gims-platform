meta {
  name: Convert Requisition to Purchase Order
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/purchase/purchase-requisitions/:id/convert
  body: json
  auth: none
}

params:path {
  id: requisition-uuid-here
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "supplier_id": "supplier-uuid-here",
    "expected_delivery_date": "2026-09-01"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Convert an approved purchase requisition into a Purchase Order.
  Permission required: `purchase_requisition.convert`
}
