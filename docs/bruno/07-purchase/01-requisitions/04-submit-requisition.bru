meta {
  name: Submit Purchase Requisition
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/purchase/purchase-requisitions/:id/submit
  body: none
  auth: none
}

params:path {
  id: requisition-uuid-here
}

headers {
  X-CSRF-Token: {{csrf_token}}
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Submit a draft purchase requisition for manager approval.
  Permission required: `purchase_requisition.submit`
}
