meta {
  name: Create Purchase Requisition
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/purchase/purchase-requisitions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Monthly raw materials replenishment",
    "items": [
      {
        "product_id": "product-uuid-here",
        "quantity": 50,
        "notes": "Urgent stock"
      }
    ]
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new purchase requisition document.
  Permission required: `purchase_requisition.create`
}
