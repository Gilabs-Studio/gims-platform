meta {
  name: Create Purchase Return
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/purchase/returns
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "goods_receipt_id": "gr-uuid-here",
    "supplier_id": "supplier-uuid-here",
    "return_date": "2026-08-15",
    "reason": "Defective item return",
    "items": [
      {
        "product_id": "product-uuid-here",
        "quantity": 5,
        "notes": "Quality audit failure"
      }
    ]
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a purchase return request.
  Permission required: `purchase_return.create`
}
