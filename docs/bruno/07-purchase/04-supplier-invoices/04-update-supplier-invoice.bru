meta {
  name: Update Supplier Invoice
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/purchase/supplier-invoices/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "due_date": "2026-09-20",
    "notes": "Payment due date extended per agreement"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update supplier invoice details.
  Permission required: `supplier_invoice.update`
}
