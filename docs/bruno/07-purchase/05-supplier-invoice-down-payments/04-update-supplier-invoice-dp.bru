meta {
  name: Update Supplier Invoice Down Payment
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/purchase/supplier-invoice-down-payments/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "amount": 5500000,
    "notes": "Adjusted DP amount"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update supplier invoice down payment details.
  Permission required: `supplier_invoice_dp.update`
}
