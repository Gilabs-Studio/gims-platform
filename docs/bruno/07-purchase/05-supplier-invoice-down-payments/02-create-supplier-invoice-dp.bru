meta {
  name: Create Supplier Invoice Down Payment
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/purchase/supplier-invoice-down-payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "purchase_order_id": "po-uuid-here",
    "supplier_id": "supplier-uuid-here",
    "amount": 5000000,
    "dp_date": "2026-08-15",
    "notes": "Advance down payment 30%"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a supplier invoice down payment.
  Permission required: `supplier_invoice_dp.create`
}
