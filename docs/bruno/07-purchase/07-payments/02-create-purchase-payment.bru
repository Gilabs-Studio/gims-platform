meta {
  name: Create Purchase Payment
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/purchase/payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "supplier_invoice_id": "invoice-uuid-here",
    "payment_date": "2026-08-15",
    "amount": 16650000,
    "payment_method": "BANK_TRANSFER",
    "bank_account_id": "bank-account-uuid-here",
    "reference_number": "TRF-BANK-8812"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new vendor payment transaction.
  Permission required: `purchase_payment.create`
}
