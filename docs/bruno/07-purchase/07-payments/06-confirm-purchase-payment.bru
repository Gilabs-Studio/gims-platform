meta {
  name: Confirm Purchase Payment
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/purchase/payments/:id/confirm
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Bank transfer cleared"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Confirm vendor payment clearance.
  Permission required: `purchase_payment.confirm`
}
