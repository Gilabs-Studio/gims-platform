meta {
  name: Update Purchase Payment
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/purchase/payments/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "reference_number": "TRF-BANK-8812-UPD",
    "notes": "Updated bank reference code"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update purchase payment details.
  Permission required: `purchase_payment.update`
}
