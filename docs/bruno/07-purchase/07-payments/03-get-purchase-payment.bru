meta {
  name: Get Purchase Payment by ID
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/purchase/payments/:id
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get detailed information of a purchase payment.
  Permission required: `purchase_payment.read`
}
