meta {
  name: Convert Goods Receipt to Supplier Invoice
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/v1/purchase/goods-receipt/:id/convert
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "invoice_number": "INV-SUPP-8831",
    "invoice_date": "2026-08-15"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Convert confirmed Goods Receipt into a Supplier Invoice.
  Permission required: `goods_receipt.convert`
}
