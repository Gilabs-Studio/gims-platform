meta {
  name: Get Goods Receipt by ID
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/purchase/goods-receipt/:id
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get detailed information of a goods receipt.
  Permission required: `goods_receipt.read`
}
