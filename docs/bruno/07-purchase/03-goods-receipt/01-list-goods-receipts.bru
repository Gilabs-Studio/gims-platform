meta {
  name: List Goods Receipts
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/purchase/goods-receipt?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List goods receipts with pagination and status filters.
  Permission required: `goods_receipt.read`
}
