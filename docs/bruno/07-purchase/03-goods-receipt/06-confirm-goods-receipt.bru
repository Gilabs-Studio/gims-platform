meta {
  name: Confirm Goods Receipt
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/purchase/goods-receipt/:id/confirm
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Physical verification completed by warehouse manager"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Confirm physical goods receipt at warehouse.
  Permission required: `goods_receipt.confirm`
}
