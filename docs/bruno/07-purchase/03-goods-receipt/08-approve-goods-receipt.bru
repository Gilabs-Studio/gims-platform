meta {
  name: Approve Goods Receipt
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/purchase/goods-receipt/:id/approve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Approved goods receipt"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Approve goods receipt.
  Permission required: `goods_receipt.approve`
}
