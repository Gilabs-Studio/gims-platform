meta {
  name: Update Goods Receipt
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/purchase/goods-receipt/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "delivery_note_number": "DN-SUPP-9921-REV",
    "notes": "Updated delivery note number"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update goods receipt details.
  Permission required: `goods_receipt.update`
}
