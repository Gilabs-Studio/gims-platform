meta {
  name: Reject Goods Receipt
  type: http
  seq: 9
}

post {
  url: {{base_url}}/api/v1/purchase/goods-receipt/:id/reject
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "rejection_reason": "Damaged goods in shipment"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Reject goods receipt.
  Permission required: `goods_receipt.reject`
}
