meta {
  name: Reject Purchase Order
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/purchase/purchase-orders/:id/reject
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "reason": "Budget limit exceeded"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Reject purchase order.
  Permission required: `purchase_order.reject`
}
