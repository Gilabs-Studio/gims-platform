meta {
  name: Submit Purchase Order
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/purchase/purchase-orders/:id/submit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Submitting for approval"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Submit purchase order for approval.
  Permission required: `purchase_order.submit`
}
