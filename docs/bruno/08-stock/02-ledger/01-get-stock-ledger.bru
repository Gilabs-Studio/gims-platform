meta {
  name: Get Stock Ledger
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/stock/ledger?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  View stock ledger movements and transaction audit trail.
  Permission required: `ledger.read`
}
