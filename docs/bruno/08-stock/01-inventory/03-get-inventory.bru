meta {
  name: Get Inventory by Product ID
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/stock/inventory/:product_id
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get detailed stock quantities of a product across warehouses.
  Permission required: `inventory.read`
}
