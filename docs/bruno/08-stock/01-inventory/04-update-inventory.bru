meta {
  name: Update Inventory Settings
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/stock/inventory/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "minimum_stock": 15,
    "maximum_stock": 600
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update inventory thresholds and settings for a warehouse stock record.
  Permission required: `inventory.update`
}
