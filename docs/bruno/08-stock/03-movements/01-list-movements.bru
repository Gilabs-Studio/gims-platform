meta {
  name: List Stock Movements
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/stock/movements?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List stock movements (transfers, adjustments, receipts).
  Permission required: `stock_movement.read`
}
