meta {
  name: Update Stock Movement
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/stock/movements/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Updated transfer remarks"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update stock movement details.
  Permission required: `stock_movement.update`
}
