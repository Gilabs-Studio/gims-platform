meta {
  name: Create Stock Opname
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/stock-opnames
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "warehouse_id": "warehouse-uuid-here",
    "opname_date": "2026-08-15",
    "notes": "Monthly physical inventory audit"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new stock opname audit record.
  Permission required: `stock_opname.create`
}
