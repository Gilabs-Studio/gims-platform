meta {
  name: Update Stock Opname
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/stock-opnames/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Updated audit counts"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update stock opname details and item counts.
  Permission required: `stock_opname.update`
}
