meta {
  name: Reject Stock Opname
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/stock-opnames/:id/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "status": "REJECTED",
    "notes": "Physical recount requested"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Reject stock opname audit.
  Permission required: `stock_opname.reject`
}
