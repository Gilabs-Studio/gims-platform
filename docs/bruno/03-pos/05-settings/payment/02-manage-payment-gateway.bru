meta {
  name: Manage Payment Gateway (Xendit)
  type: http
  seq: 2
}

put {
  url: {{base_url}}/api/v1/pos/settings/payment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "gateway": "xendit",
    "secret_key": "xnd_development_...",
    "webhook_token": "token_...",
    "is_enabled": true
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update POS payment gateway settings (Owner/Admin only).
  Permission required: `pos.payment.manage`
}
