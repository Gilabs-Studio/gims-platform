meta {
  name: Redeem Loyalty Points
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/pos/loyalty/members/:id/redeem
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "points_to_redeem": 100,
    "reward_id": "reward-uuid-here"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Redeem points for a loyalty member.
  Permission required: `loyalty.redeem`
}
