meta {
  name: List Loyalty Members
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/loyalty/members?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List registered loyalty program members with their point balances.
  Permission required: `loyalty.read`
}
