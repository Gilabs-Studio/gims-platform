meta {
  name: Delete Feedback Form
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/api/v1/pos/feedback/forms/:id
  body: none
  auth: none
}

headers {
  X-CSRF-Token: {{csrf_token}}
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Soft delete a feedback form.
  Permission required: `feedback.delete`
}
