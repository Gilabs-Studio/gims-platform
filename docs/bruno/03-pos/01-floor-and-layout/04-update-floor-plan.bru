meta {
  name: Update Floor Plan
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/pos/floor-plans/:id
  body: json
  auth: none
}

params:path {
  id: 1
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Updated Main Dining Area",
    "description": "Updated description",
    "width": 1400,
    "height": 900
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update floor plan metadata and canvas dimensions.
  Permission required: `pos.layout.update`
}
