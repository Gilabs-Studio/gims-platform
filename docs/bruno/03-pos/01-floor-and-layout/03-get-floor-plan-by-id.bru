meta {
  name: Get Floor Plan Details
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/pos/floor-plans/:id
  body: none
  auth: none
}

params:path {
  id: 1
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Fetch floor plan details including tables, seats, and layout objects.
  Permission required: `pos.layout.read`
}
