meta {
  name: Create Floor Plan
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/pos/floor-plans
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "outlet_id": "outlet-uuid-here",
    "name": "Main Dining Area",
    "description": "Ground floor main dining hall layout",
    "width": 1200,
    "height": 800
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new POS floor plan layout canvas.
  Permission required: `pos.layout.create`
}
