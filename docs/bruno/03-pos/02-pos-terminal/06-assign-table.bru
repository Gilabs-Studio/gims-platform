meta {
  name: Assign Table to POS Order
  type: http
  seq: 6
}

put {
  url: {{base_url}}/api/v1/pos/orders/3440f00e-69e8-449c-9cf0-f8afb0adcb53/table
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "table_id": "tbl-2",
    "table_label": "T2"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Assign or re-assign table to a POS order.
  Permission required: `pos.order.update`
}
