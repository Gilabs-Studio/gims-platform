meta {
  name: Create POS Order
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/pos/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
  X-Idempotency-Key: idempotency-key-uuid-123
}

body:json {
  {
    "outlet_id": "0e000001-0000-0000-0000-000000000001",
    "order_type": "DINE_IN",
    "table_id": "tbl-1",
    "table_label": "T1",
    "customer_name": "John Doe",
    "guest_count": 1
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new POS transaction order.
  Permission required: `pos.order.create`
}
