meta {
  name: List POS Orders
  type: http
  seq: 8
}

get {
  url: {{base_url}}/api/v1/pos/orders?outlet_id=0e000001-0000-0000-0000-000000000001&status=DRAFT
  body: none
  auth: none
}

headers {
  X-CSRF-Token: {{csrf_token}}
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List POS orders filtered by outlet and status.
  Permission required: `pos.order.view`
}
