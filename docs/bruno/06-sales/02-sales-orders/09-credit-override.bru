meta {
  name: Override Credit Limit on Sales Order
  type: http
  seq: 9
}

post {
  url: {{base_url}}/api/v1/sales/sales-orders/:id/credit-override
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "override_reason": "Authorized by Sales Director for strategic customer"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Override customer credit limit block on sales order creation/approval.
  Permission required: `sales_order.credit_override`
}
