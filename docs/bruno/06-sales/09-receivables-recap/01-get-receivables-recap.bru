meta {
  name: Get Accounts Receivable Recap
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/sales/receivables-recap?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get summary recap of outstanding customer receivables.
  Permission required: `receivables_recap.read`
}
