meta {
  name: Confirm Sales Payment
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/sales/payments/:id/confirm
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Payment receipt confirmed"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Confirm customer payment receipt into bank account.
  Permission required: `sales_payment.confirm`
}
