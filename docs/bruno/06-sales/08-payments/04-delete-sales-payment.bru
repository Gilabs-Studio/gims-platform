meta {
  name: Delete Sales Payment
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/api/v1/sales/payments/:id
  body: none
  auth: none
}

headers {
  X-CSRF-Token: {{csrf_token}}
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Soft delete a unconfirmed sales payment.
  Permission required: `sales_payment.delete`
}
