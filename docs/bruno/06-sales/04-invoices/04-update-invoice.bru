meta {
  name: Update Customer Invoice
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/sales/customer-invoices/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "due_date": "2026-09-30"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update customer invoice details.
  Permission required: `customer_invoice.update`
}
