meta {
  name: Update Sales Return
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/sales/returns/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "reason": "Updated wrong item return reason"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update sales return details.
  Permission required: `sales_return.update`
}
