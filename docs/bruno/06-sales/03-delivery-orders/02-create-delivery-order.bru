meta {
  name: Create Delivery Order
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/sales/delivery-orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "sales_order_id": "sales-order-uuid-here",
    "delivery_date": "2026-08-16",
    "courier_agency_id": "courier-uuid-here",
    "tracking_number": "TRK-987654321"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new delivery order.
  Permission required: `delivery_order.create`
}
