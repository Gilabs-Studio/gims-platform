meta {
  name: Ship Delivery Order
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/sales/delivery-orders/:id/ship
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "shipped_at": "2026-08-16T08:30:00Z"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Mark delivery order as shipped.
  Permission required: `delivery_order.ship`
}
