meta {
  name: Create Sales Estimation
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/sales/estimations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "customer_id": "customer-uuid-here",
    "estimation_date": "2026-08-15",
    "estimated_total": 45000000,
    "notes": "Custom fabrication cost estimation"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a sales estimation calculation.
  Permission required: `sales_estimation.create`
}
