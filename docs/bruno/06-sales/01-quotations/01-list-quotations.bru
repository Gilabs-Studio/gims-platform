meta {
  name: List Sales Quotations
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/sales-quotations?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List sales quotations with pagination and search filters.
  Permission required: `sales_quotation.read`
}
