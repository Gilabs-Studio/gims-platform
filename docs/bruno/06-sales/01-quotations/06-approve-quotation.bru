meta {
  name: Approve Sales Quotation
  type: http
  seq: 6
}

patch {
  url: {{base_url}}/api/v1/sales/sales-quotations/:id/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "status": "APPROVED"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Approve sales quotation status.
  Permission required: `sales_quotation.approve`
}
