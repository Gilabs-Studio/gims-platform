meta {
  name: Create Sales Quotation
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/sales-quotations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "customer_id": "customer-uuid-here",
    "quotation_date": "2026-08-15",
    "valid_until": "2026-08-30",
    "items": [
      {
        "product_id": "product-uuid-here",
        "quantity": 10,
        "price": 150000,
        "discount_percent": 5
      }
    ]
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new sales quotation document.
  Permission required: `sales_quotation.create`
}
