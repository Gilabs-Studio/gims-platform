meta {
  name: Create Customer Down Payment
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/sales/customer-invoice-down-payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "sales_order_id": "so-uuid-here",
    "customer_id": "customer-uuid-here",
    "amount": 10000000,
    "dp_date": "2026-08-15",
    "notes": "Advance customer deposit"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create customer invoice down payment.
  Permission required: `customer_invoice_dp.create`
}
