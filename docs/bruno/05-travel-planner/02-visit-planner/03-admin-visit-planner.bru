meta {
  name: Admin Visit Planner Settings
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/travel/visit-planner/admin
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "max_daily_visits": 8,
    "gps_tracking_interval_mins": 15,
    "require_photo": true
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Admin configuration for visit planner rules and policies.
  Permission required: `travel.visit.admin`
}
