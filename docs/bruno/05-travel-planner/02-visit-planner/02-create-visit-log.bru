meta {
  name: Create Visit Log
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/travel/visit-planner
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "travel_plan_id": "plan-uuid-here",
    "customer_id": "customer-uuid-here",
    "check_in_time": "2026-09-01T09:00:00Z",
    "latitude": -7.2575,
    "longitude": 112.7521,
    "notes": "Arrived at customer headquarters"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a visit log in the visit planner.
  Permission required: `travel.visit.create`
}
