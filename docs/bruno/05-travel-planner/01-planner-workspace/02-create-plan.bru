meta {
  name: Create Travel Plan
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/travel-planner/plans
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "title": "Surabaya Client Visits Q3",
    "description": "Multi-site client and supplier visit trip",
    "start_date": "2026-09-01",
    "end_date": "2026-09-05"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new travel planner itinerary trip.
  Permission required: `travel_planner.create`
}
