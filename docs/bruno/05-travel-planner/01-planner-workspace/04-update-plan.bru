meta {
  name: Update Travel Plan
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/travel/travel-planner/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "title": "Surabaya Client Visits - September 2026",
    "start_date": "2026-09-01",
    "end_date": "2026-09-05",
    "destination": "Surabaya, East Java",
    "budget": 7500000
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update travel plan details.
  Permission required: `travel_planner.update`
}
