meta {
  name: 21 - Can Convert Applicant
  type: http
  seq: 21
}

get {
  url: {{base_url}}/api/v1/hrd/applicants/:id/can-convert
  body: none
  auth: inherit
}

params:path {
  id: b0000002-0000-0000-0000-000000000001
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

docs {
  Check if an applicant can be converted to an employee (must be in hired stage and not already converted).
  Permission required: `recruitment.read`
}
