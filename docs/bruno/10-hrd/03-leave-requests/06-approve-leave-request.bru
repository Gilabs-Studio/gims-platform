meta {
  name: Approve Leave Request
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/hrd/leave-requests/:id/approve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Approved by supervisor"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Approve an employee leave request.
  Permission required: `leave_request.approve`
}
