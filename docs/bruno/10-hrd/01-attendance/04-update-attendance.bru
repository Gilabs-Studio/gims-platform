meta {
  name: Update Attendance Record
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/hrd/attendance/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "clock_out": "17:30",
    "notes": "Adjusted clock out time"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update attendance record timestamps or notes.
  Permission required: `attendance.update`
}
