meta {
  name: List Leave Requests
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/hrd/leave-requests?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List leave requests with pagination and status filters.
  Permission required: `leave_request.read`
}
