meta {
  name: Approve Overtime Request
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/hrd/overtime/:id/approve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Approved by supervisor"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Approve employee overtime request.
  Permission required: `overtime.approve`
}
