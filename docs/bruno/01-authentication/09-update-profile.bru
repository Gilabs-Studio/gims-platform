meta {
  name: Update Profile
  type: http
  seq: 9
}

put {
  url: {{base_url}}/api/v1/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Jane Doe",
    "phone": "+628123456789",
    "avatar_url": "https://example.com/avatar.jpg"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update current user profile information.
  Permission required: `profile.update`
}
