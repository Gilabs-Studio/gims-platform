meta {
  name: Update User Settings
  type: http
  seq: 11
}

put {
  url: {{base_url}}/api/v1/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "theme": "dark",
    "language": "id",
    "notifications_enabled": true
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update current user settings and preferences.
  Permission required: `settings.update`
}
