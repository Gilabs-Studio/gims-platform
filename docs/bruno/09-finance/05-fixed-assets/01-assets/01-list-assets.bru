meta {
  name: List Fixed Assets
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/finance/fixed-assets/assets?page=1&per_page=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  per_page: 20
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List registered company fixed assets with optional filtering by status, category, location, or search.
  Permission required: `asset.read`
}
