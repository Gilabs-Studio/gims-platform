meta {
  name: Get Asset Detail
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/finance/fixed-assets/assets/{{asset_id}}
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get full asset details including financial book value, depreciation schedule, attachment URLs, and audit history.
  Permission required: `asset.read`
}
