meta {
  name: List Chart of Accounts
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/finance/coa?page=1&per_page=100
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 100
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Fetch full tree hierarchy of Chart of Accounts.
  Permission required: `coa.read`
}
