meta {
  name: Cancel Journal Entry
  type: http
  seq: 7
}

patch {
  url: {{base_url}}/api/v1/finance/accounting/journal-entries/:id/cancel
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "cancellation_reason": "Duplicate entry error"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Cancel unposted or draft journal entry.
  Permission required: `journal.cancel`
}
