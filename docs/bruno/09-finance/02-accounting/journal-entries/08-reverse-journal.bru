meta {
  name: Reverse Journal Entry
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/finance/accounting/journal-entries/:id/reverse
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "reversal_date": "2026-08-16",
    "reversal_reason": "Correction of posting error"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a reversing journal entry to offset a posted entry.
  Permission required: `journal.reverse`
}
