meta {
  name: Exclude Statement Line
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/finance/bank-reconciliations/:id/line/:line_id/exclude
  body: json
  auth: bearer
}

params:path {
  id: {{reconciliationId}}
  line_id: {{lineId}}
}

body:json {
  {
    "reason": "Duplicate bank fee entry"
  }
}

auth:bearer {
  token: {{accessToken}}
}
