meta {
  name: Create Non-Trade Payable
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/finance/ap/non-trade-payables
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "vendor_name": "PLN Electricity Utility",
    "invoice_number": "PLN-2026-08",
    "amount": 4200000,
    "due_date": "2026-08-25",
    "notes": "Monthly office electricity bill"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a non-trade payable record.
  Permission required: `non_trade_payable.create`
}
