meta {
  name: Update Non-Trade Payable
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/finance/ap/non-trade-payables/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "amount": 4350000,
    "notes": "Adjusted electricity bill total"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update non-trade payable details.
  Permission required: `non_trade_payable.update`
}
