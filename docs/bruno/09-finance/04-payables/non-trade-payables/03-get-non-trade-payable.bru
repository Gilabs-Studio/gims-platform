meta {
  name: Get Non-Trade Payable by ID
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/finance/ap/non-trade-payables/:id
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get detailed information of a non-trade payable.
  Permission required: `non_trade_payable.read`
}
