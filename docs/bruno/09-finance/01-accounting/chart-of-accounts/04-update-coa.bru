meta {
  name: Update Account
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/finance/accounting/coa/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "account_name": "Cash on Hand - Main Office",
    "description": "Updated cash account description"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update Chart of Accounts account details.
  Permission required: `coa.update`
}
