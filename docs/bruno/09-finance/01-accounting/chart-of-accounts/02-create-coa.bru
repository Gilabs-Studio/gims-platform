meta {
  name: Create Account
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/finance/coa
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "account_code": "1110-01",
    "account_name": "Kas Kecil Utama",
    "account_type": "ASSET",
    "parent_id": null,
    "is_header": false
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new GL Chart of Account entry.
  Permission required: `coa.create`
}
