meta {
  name: Update Journal Entry
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/finance/accounting/journal-entries/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "description": "Updated office supplies expense description"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update draft journal entry.
  Permission required: `journal.update`
}
