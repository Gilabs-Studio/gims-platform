meta {
  name: Get Journal Entry by ID
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/finance/accounting/journal-entries/:id
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get detailed information of a journal entry.
  Permission required: `journal.read`
}
