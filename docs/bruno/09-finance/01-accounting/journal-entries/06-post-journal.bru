meta {
  name: Post Journal Entry
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/finance/accounting/journal-entries/:id/post
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Post journal entry to General Ledger.
  Permission required: `journal.post`
}
