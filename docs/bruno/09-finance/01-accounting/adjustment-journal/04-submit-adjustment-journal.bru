meta {
  name: Submit Adjustment Journal
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/v1/finance/accounting/journal-entries/adjustment/:id/submit-approval
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Submitting adjustment for finance manager sign-off"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Submit adjustment journal for approval.
  Permission required: `adjustment_journal.submit`
}
