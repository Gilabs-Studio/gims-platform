meta {
  name: Approve Adjustment Journal
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/api/v1/finance/accounting/journal-entries/adjustment/:id/approve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "notes": "Approved"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Approve adjustment journal entry.
  Permission required: `adjustment_journal.approve`
}
