meta {
  name: Get Cash Flow Summary
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/finance/reports/cash-flow/summary?start_date=2026-05-01&end_date=2026-05-31
  body: none
  auth: none
}

params:query {
  start_date: 2026-05-01
  end_date: 2026-05-31
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get top KPI summary metrics for Cash Flow Statement (Net Cash Flow, Cash Inflow, Cash Outflow, Ending Cash Balance with growth rates).
  Permission required: `cash_flow_statement.read`
}
