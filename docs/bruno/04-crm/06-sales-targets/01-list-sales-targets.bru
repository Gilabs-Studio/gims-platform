meta {
  name: List Sales Targets
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/crm/sales-targets?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List CRM sales targets for sales reps/teams.
  Permission required: `sales_target.read`
}
