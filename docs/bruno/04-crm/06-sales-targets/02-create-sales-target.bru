meta {
  name: Create Sales Target
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/crm/sales-targets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "employee_id": "employee-uuid-here",
    "period_year": 2026,
    "period_month": 8,
    "target_amount": 250000000
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new sales target.
  Permission required: `sales_target.create`
}
