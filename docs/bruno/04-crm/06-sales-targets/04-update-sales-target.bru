meta {
  name: Update Sales Target
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/crm/sales-targets/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "target_amount": 300000000
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update sales target amount.
  Permission required: `sales_target.update`
}
