meta {
  name: List Lead Sources
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/crm/settings/lead-sources?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List CRM lead sources.
  Permission required: `crm_lead_source.read`
}
