meta {
  name: Create Pipeline Stage
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/crm/pipeline-stages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Qualification",
    "order": 1,
    "probability": 20,
    "color": "#3B82F6"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new CRM pipeline stage.
  Permission required: `crm_pipeline_stage.create`
}
