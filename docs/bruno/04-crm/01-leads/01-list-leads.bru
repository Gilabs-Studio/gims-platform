meta {
  name: List Leads
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/crm/leads?page=1&per_page=10
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  List sales leads with filtering, search, and pagination.
  Permission required: `crm_lead.read`
}
