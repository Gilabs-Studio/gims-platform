meta {
  name: Create Visit Report
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/crm/visits
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "customer_id": "customer-uuid-here",
    "visit_date": "2026-08-15",
    "purpose": "Product Demonstration and Pricing Discussion",
    "notes": "Met with procurement team"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new CRM visit report.
  Permission required: `crm_visit.create`
}
