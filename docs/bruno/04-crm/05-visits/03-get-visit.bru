meta {
  name: Get Visit Report by ID
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/crm/visits/:id
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get detailed information of a visit report.
  Permission required: `crm_visit.read`
}
