meta {
  name: Get Deal by ID
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/crm/deals/:id
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Get detailed information of a deal.
  Permission required: `crm_deal.read`
}
