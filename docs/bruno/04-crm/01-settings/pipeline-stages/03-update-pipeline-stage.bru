meta {
  name: Update Pipeline Stage
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/crm/pipeline-stages/:id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Initial Contact",
    "order": 1,
    "probability": 25,
    "color": "#2563EB"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Update a pipeline stage.
  Permission required: `crm_pipeline_stage.update`
}
