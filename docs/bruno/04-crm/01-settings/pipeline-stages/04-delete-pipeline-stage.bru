meta {
  name: Delete Pipeline Stage
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/api/v1/crm/pipeline-stages/:id
  body: none
  auth: none
}

headers {
  X-CSRF-Token: {{csrf_token}}
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Delete a pipeline stage.
  Permission required: `crm_pipeline_stage.delete`
}
