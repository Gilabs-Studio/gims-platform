meta {
  name: Create Lead Source
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/crm/settings/lead-sources
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Trade Exhibition 2026",
    "code": "EXHIBITION_2026"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new lead source option.
  Permission required: `crm_lead_source.create`
}
