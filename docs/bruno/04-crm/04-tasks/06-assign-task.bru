meta {
  name: Assign Task
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/crm/tasks/:id/assign
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "assigned_to": "employee-uuid-here"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Assign a task to an employee.
  Permission required: `crm_task.assign`
}
