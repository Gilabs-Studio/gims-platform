meta {
  name: Create Task
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/crm/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "title": "Follow up quotation for PT Sentosa",
    "due_date": "2026-08-20T17:00:00Z",
    "priority": "HIGH",
    "assigned_to": "employee-uuid-here",
    "notes": "Confirm receipt of revised pricing"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new CRM task.
  Permission required: `crm_task.create`
}
