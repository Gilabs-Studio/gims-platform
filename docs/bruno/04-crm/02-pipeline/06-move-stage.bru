meta {
  name: Move Deal Stage
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/crm/deals/:id/move-stage
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "pipeline_stage_id": "new-stage-uuid-here",
    "notes": "Negotiation completed, moving to Proposal Accepted"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Move deal to a different pipeline stage.
  Permission required: `crm_deal.move_stage`
}
