meta {
  name: Create Lead
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/crm/leads
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "company_name": "PT Maju Bersama",
    "contact_name": "Budi Santoso",
    "email": "budi@majubersama.com",
    "phone": "08123456789",
    "lead_source_id": "source-uuid-here",
    "lead_status_id": "status-uuid-here"
  }
}

script:post-response {
  const csrfHeader = res.getHeader('X-CSRF-Token');
  if (csrfHeader) {
    bru.setEnvVar('csrf_token', csrfHeader);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Create a new sales lead.
  Permission required: `crm_lead.create`
}
